<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/activity_background"
    tools:context=".MainActivity">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_centerInParent="true">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/yellow"
            android:textSize="@dimen/title_size"
            android:textAlignment="center"
            android:lineSpacingMultiplier="0.5"
            android:fontFamily="@font/starjhol"
            android:paddingBottom="20dp"/>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_marginBottom="100dp"
            android:id="@+id/main_menu_buttons">

            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:backgroundTint="@color/yellow"
                android:layout_marginBottom="@dimen/menu_buttons_margin"
                app:icon="@drawable/tilt_mode"
                app:iconSize="@dimen/icon_size"
                app:iconTint="@color/black"
                app:iconGravity="textStart"
                android:text="@string/tilt_mode"
                android:textSize="20sp"
                android:textColor="@color/black"
                android:textAllCaps="false"
                android:fontFamily="@font/starjedi"
                android:id="@+id/main_BTN_tilt"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:backgroundTint="@color/yellow"
                android:layout_marginBottom="@dimen/menu_buttons_margin"
                app:icon="@drawable/buttons_mode"
                app:iconSize="@dimen/icon_size"
                app:iconTint="@color/black"
                app:iconGravity="textStart"
                android:text="@string/buttons_mode"
                android:textSize="20sp"
                android:textColor="@color/black"
                android:textAllCaps="false"
                android:fontFamily="@font/starjedi"
                android:id="@+id/main_BTN_buttons"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:backgroundTint="@color/yellow"
                android:layout_marginBottom="@dimen/menu_buttons_margin"
                app:icon="@drawable/leaderboard"
                app:iconSize="@dimen/icon_size"
                app:iconTint="@color/black"
                app:iconGravity="textStart"
                android:text="@string/leaderboard"
                android:textSize="20sp"
                android:textColor="@color/black"
                android:textAllCaps="false"
                android:fontFamily="@font/starjedi"
                android:id="@+id/main_BTN_leaderboard"/>

        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</RelativeLayout>